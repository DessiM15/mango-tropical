# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling output
/.shots/
/.menu-render/

# Source material kept out of the repo:
# hero-video.html is a saved Facebook page belonging to a different business
# (Mex Taco House) and carries ~50MB of their bundled JavaScript. Nothing in
# the build reads it. assets/menu.pdf and assets/logo.jpg are committed because
# scripts/extract_menu_art.py regenerates all product imagery from them.
/assets/hero-video.html
/assets/hero-video_files/
